# Copy to .env and adjust if needed. None of these are required — every
# value below has a sensible default in soccerway_scraper/config.py.

# How often the scheduler re-scrapes each tracked league, in minutes.
# Default: 45. Standings only change when a match finishes, so polling
# faster than ~30 min buys no fresher data most of the day — it just adds
# load on Soccerway for nothing. Keep this in the 30-60 min range; this is
# a personal/non-commercial project and should stay a good citizen.
SCRAPE_INTERVAL_MINUTES=45

# Minimum delay (seconds) the scheduler waits between scraping one tracked
# league and the next, within a single run. Prevents a burst of requests
# when several leagues are tracked. Default: 5.
#
# Rate-limit / concurrency assumptions: leagues are scraped SEQUENTIALLY,
# one headless browser at a time, never in parallel. Soccerway has no
# documented public rate limit for this project to target — we assume
# there isn't a generous one and stay conservative rather than testing it.
# If concurrent scraping is ever added, this delay needs to become a
# shared rate limiter across workers, not a per-worker sleep.
MIN_REQUEST_DELAY_SECONDS=5

# Path to the SQLite database file. Default: soccerway.db in the repo root.
SOCCERWAY_DB_PATH=soccerway.db

# NOTE: tracked leagues (which country/league pairs to scrape) are NOT
# configured here. They live in soccerway_scraper.config.TRACKED_LEAGUES
# (a list of (country_slug, league_slug) tuples) because it's structured
# data, not a scalar. Add a league by either:
#   1. Appending a tuple to TRACKED_LEAGUES in config.py, or
#   2. POST /leagues with {"country": "...", "league": "..."} at runtime
#      (persists to the database, triggers an immediate scrape).
# See the README's "Adding a new league" section for details.
